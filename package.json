{
  "name": "@rumtrace/rumtrace-rn-ios",
  "version": "0.9.6",
  "summary": "Rumtrace React Native iOS SDK for Real User Monitoring",
  "description": "React Native wrapper around the Rumtrace iOS SDK for real user monitoring, crash reporting, and performance tracking.",
  "homepage": "https://github.com/rumtracehq/rumtrace-react-native",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumtracehq/rumtrace-react-native.git"
  },
  "license": "Apache-2.0",
  "author": "Rumtrace <team@rumtrace.com>",
  "scripts": {
    "prepack": "pnpm build",
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "ios",
    "RumtraceRnIos.podspec",
    "app.plugin.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@changesets/cli": "^2.31.0",
    "@react-native/babel-preset": "0.81.0",
    "@react-native/eslint-config": "0.81.0",
    "@react-native/typescript-config": "0.81.0",
    "@types/react": "^19.1.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-builder-bob": "^0.40.13",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.79",
    "@expo/config-plugins": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "rumtrace": {
    "iosSdkVersion": "0.9.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "codegenConfig": {
    "name": "Rumtrace",
    "type": "modules",
    "jsSrcsDir": "./src"
  }
}
